{
  "name": "guangtuo-oem-digital-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "models:generate": "node scripts/generate-sku-models-v2.mjs",
    "3d:hunyuan:preflight": "pwsh -NoProfile -File services/hunyuan3d/run-primary.ps1 -PreflightOnly",
    "3d:hunyuan:start": "pwsh -NoProfile -File services/hunyuan3d/run-primary.ps1",
    "3d:gateway:start": "pwsh -NoProfile -File services/hunyuan3d/run-studio-api.ps1",
    "test": "vitest run",
    "test:baseline": "vitest run tests/site-repositioning.test.ts",
    "test:hunyuan": "services/hunyuan3d/.gpu-venv/Scripts/python.exe -m unittest services.hunyuan3d.tests.test_studio_api",
    "test:watch": "vitest",
    "infra:bundle": "esbuild src/server/aws/api-entry.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/lambda-api/index.js --external:@aws-sdk/* && esbuild src/server/aws/ai-worker-entry.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/lambda-ai/index.js --external:@aws-sdk/* && esbuild src/server/aws/mail-worker-entry.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/lambda-mail/index.js --external:@aws-sdk/*",
    "pretest": "pnpm infra:bundle",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm test && pnpm test:hunyuan && pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1009.0",
    "@aws-sdk/client-dynamodb": "3.1009.0",
    "@aws-sdk/client-sesv2": "3.1009.0",
    "@aws-sdk/client-sqs": "3.1009.0",
    "@aws-sdk/lib-dynamodb": "3.1009.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "next": "16.3.1",
    "next-intl": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "aws-cdk-lib": "2.245.0",
    "constructs": "10.4.2",
    "esbuild": "0.27.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
