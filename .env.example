# Public site origin used by sitemap/canonical generation.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Leave empty for the local-only demonstration. Set only after the API is deployed.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/v1

# Anonymous paid generation stays disabled. CMS uses a private server-to-server gateway.
NEXT_PUBLIC_STUDIO_API_URL=
STUDIO_GATEWAY_URL=http://127.0.0.1:8091
STUDIO_GATEWAY_TOKEN=
STUDIO_GENERATION_ENABLED=false
STUDIO_LICENSE_ACCEPTED=false

# Server-only address of the private image-to-3D worker.
STUDIO_MODEL_WORKER_URL=http://127.0.0.1:8080

# Exact browser origins allowed to call the Studio API.
STUDIO_ALLOWED_ORIGINS=https://www.example.com

# Server-only key used by the Studio API for concept images.
# Keep this unprefixed: NEXT_PUBLIC_* values are sent to the browser.
OPENAI_API_KEY=

# Server-only RAG provider, separate from the image-generation key.
RAG_API_BASE_URL=https://api.openai.com/v1
RAG_API_KEY=
RAG_MODEL=
RAG_EMBEDDING_MODEL=
# Optional provider-supported dimension. Changing model/endpoint/dimension needs a new index.
# RAG_EMBEDDING_DIMENSIONS=1536

# Never place OpenAI, AWS, Bedrock, SES or Microsoft Graph secrets in NEXT_PUBLIC_* variables.

# Optional owner notifications. Server-only; leave unset while email notifications are paused.
# NOTIFICATION_EMAIL=eileendeng1130@gmail.com
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Free offline CMS translation. Default: <project>/.venv-translation Python.
# Run pnpm translation:setup as the CMS service user before publishing.
# CMS_TRANSLATION_PYTHON=
# On locked-down Linux services, place Argos models/caches in the private data directory:
# XDG_DATA_HOME=/var/lib/showkibiotech/translation/data
# XDG_CACHE_HOME=/var/lib/showkibiotech/translation/cache
# XDG_CONFIG_HOME=/var/lib/showkibiotech/translation/config

# Free local templates and FFmpeg remain available alongside optional content AI.
# Content AI is server-only; used for prompts, articles, marketing copy and image reworking.
# CONTENT_AI_BASE_URL=https://testvideo.site/v1
# CONTENT_AI_API_KEY=
# CONTENT_AI_TEXT_MODEL=gpt-5.6-sol
# CONTENT_AI_IMAGE_MODEL=gpt-image-2
# Leave all publishing credentials unset until customer accounts are authorized.
# MARKETING_FFMPEG_PATH=ffmpeg
# Postiz base must include /api/public/v1. Self-hosted loopback HTTP is allowed.
# MARKETING_POSTIZ_URL=https://postiz.example.com/api/public/v1
# MARKETING_POSTIZ_API_KEY=
# MARKETING_WECHAT_APP_ID=
# MARKETING_WECHAT_APP_SECRET=
# Optional social-auto-upload CLI. Account names refer to its private saved sessions.
# MARKETING_SAU_BIN=
# MARKETING_SAU_CWD=
# MARKETING_DOUYIN_ACCOUNT=
# MARKETING_XIAOHONGSHU_ACCOUNT=

# Business CRM uses local templates and CSV imports without paid calls.
# Server-only Chatwoot connection; use an existing authorized inbox account.
# BUSINESS_CHATWOOT_URL=https://inbox.example.com
# BUSINESS_CHATWOOT_ACCOUNT_ID=
# BUSINESS_CHATWOOT_TOKEN=
# TikHub public TikTok comments adapter. Pricing varies by endpoint; verify credits first.
# Enabling requires operator approval of quota/costs. Never place tokens in NEXT_PUBLIC_*.
# BUSINESS_TIKHUB_TOKEN=
# BUSINESS_TIKHUB_ENABLED=false
# BUSINESS_TIKHUB_DAILY_LIMIT=5
