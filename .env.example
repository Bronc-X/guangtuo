# Public site origin used by sitemap/canonical generation.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Leave empty for the local-only demonstration. Set only after the API is deployed.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/v1

# Public Studio API. In development this may be omitted to use http://127.0.0.1:8091.
# In production it must point to the managed HTTPS gateway, never to a customer's machine.
NEXT_PUBLIC_STUDIO_API_URL=https://studio-api.example.com

# Server-only address of the private image-to-3D worker.
STUDIO_MODEL_WORKER_URL=http://127.0.0.1:8080

# Exact browser origins allowed to call the Studio API.
STUDIO_ALLOWED_ORIGINS=https://www.example.com

# Server-only key used by the Studio API for concept images.
# Keep this unprefixed: NEXT_PUBLIC_* values are sent to the browser.
OPENAI_API_KEY=

# Never place OpenAI, AWS, Bedrock, SES or Microsoft Graph secrets in NEXT_PUBLIC_* variables.
