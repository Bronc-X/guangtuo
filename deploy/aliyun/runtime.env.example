NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=1536
CMS_BUILD_NODE_OPTIONS=--max-old-space-size=1280
CMS_BUILD_LOW_PRIORITY=1
CMS_BUILD_SCOPE=1
CMS_BUILD_IO_READ_LIMIT=/var/lib/showkibiotech/cms 30M
CMS_BUILD_IO_READ_IOPS=/var/lib/showkibiotech/cms 500
CMS_BUILD_IO_WRITE_LIMIT=/var/lib/showkibiotech/cms 20M
CMS_BUILD_IO_WRITE_IOPS=/var/lib/showkibiotech/cms 500
NEXT_PUBLIC_SITE_URL=https://showkibiotech.com
CMS_DATA_DIR=/var/lib/showkibiotech/cms
CMS_PUBLISHED_CONTENT_PATH=/var/lib/showkibiotech/cms/published-content.json
CMS_PUBLIC_UPLOAD_DIR=/var/lib/showkibiotech/cms/public-media
CMS_PROJECT_DIR=/opt/showkibiotech/app
CMS_DEPLOY_ROOT=/var/www/showkibiotech
CMS_ALLOWED_ORIGIN=https://showkibiotech.com
CMS_PORT=3111
CMS_TRUST_PROXY=true
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_CMS_API_URL=
# Leave generation disabled until a paid provider and controlled gateway are approved.
NEXT_PUBLIC_STUDIO_API_URL=
# Fill all four settings together. Use a dedicated mailbox; never NEXT_PUBLIC_*.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=website@example.com
# SMTP_PASSWORD=REPLACE_IN_PRIVATE_RUNTIME_ENV
# SMTP_FROM=website@example.com
# NOTIFICATION_EMAIL=eileendeng1130@gmail.com
# Notifications remain paused until SMTP and NOTIFICATION_EMAIL are both configured.

# Server-only RAG. Leave unset until credentials and external data processing are approved.
# RAG_API_BASE_URL=https://api.openai.com/v1
# RAG_API_KEY=SET_IN_PRIVATE_RUNTIME_ENV
# RAG_MODEL=YOUR_STRUCTURED_OUTPUT_MODEL
# RAG_EMBEDDING_MODEL=YOUR_EMBEDDING_MODEL
# RAG_EMBEDDING_DIMENSIONS=1536

# Private Studio gateway, HTTPS or loopback only. Never put the token in NEXT_PUBLIC_*.
# STUDIO_GATEWAY_URL=http://127.0.0.1:8091
# STUDIO_GATEWAY_TOKEN=SET_SAME_PRIVATE_TOKEN_ON_NODE_AND_PYTHON
STUDIO_GENERATION_ENABLED=false
STUDIO_LICENSE_ACCEPTED=false
# Python gateway additionally needs OPENAI_API_KEY and STUDIO_MODEL_WORKER_URL.
# It is a separate GPU host/process, not the 2 GB web server.
